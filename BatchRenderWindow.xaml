<Window x:Class="LOTRAOM_Viewport.BatchRenderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Render" Width="560" Height="790" MinWidth="520" MinHeight="580"
        Background="#0C1016" Foreground="#ECE8D8" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Closing="Window_Closing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="BATCH RENDER" Foreground="{StaticResource AccentBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,0,14" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SettingsPanel" Margin="0,0,12,0">
                <TextBlock Text="Meshes" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                <ComboBox x:Name="ScopeCombo" IsEditable="False" />
                <TextBlock Text="Output folder" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="OutputFolderBox" />
                    <Button Grid.Column="1" Width="36" Margin="8,0,0,0" Padding="0" ToolTip="Choose output folder" Click="BrowseOutput_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" />
                    </Button>
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Resolution" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                        <ComboBox x:Name="SizePresetCombo" IsEditable="False" SelectionChanged="SizePreset_SelectionChanged">
                            <ComboBoxItem Content="512 x 512" /><ComboBoxItem Content="1024 x 1024" />
                            <ComboBoxItem Content="2048 x 2048" /><ComboBoxItem Content="2048 x 3072" />
                            <ComboBoxItem Content="3840 x 2160" /><ComboBoxItem Content="Custom" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Existing files" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                        <ComboBox x:Name="ExistingFilesCombo" IsEditable="False">
                            <ComboBoxItem Content="Skip existing" /><ComboBoxItem Content="Replace existing" />
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Width (px)" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                        <TextBox x:Name="WidthBox" MaxLength="4" TextChanged="Dimensions_TextChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Height (px)" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                        <TextBox x:Name="HeightBox" MaxLength="4" TextChanged="Dimensions_TextChanged" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Background" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                        <ComboBox x:Name="BackgroundCombo" IsEditable="False">
                            <ComboBoxItem Content="Transparent" /><ComboBoxItem Content="Studio" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,6">
                        <CheckBox x:Name="GridCheckBox" Content="Grid" Foreground="#D8D4C1" />
                        <CheckBox x:Name="OrganiseCheckBox" Content="Module / package folders" Foreground="#D8D4C1" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="CAMERA" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" Margin="0,18,0,8" />
                <ComboBox x:Name="CameraPresetCombo" IsEditable="False" SelectionChanged="CameraPreset_SelectionChanged">
                    <ComboBoxItem Content="Front" /><ComboBoxItem Content="Back" /><ComboBoxItem Content="Left" />
                    <ComboBoxItem Content="Right" /><ComboBoxItem Content="Three-quarter" /><ComboBoxItem Content="Custom" />
                </ComboBox>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Yaw (deg)" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                        <TextBox x:Name="YawBox" MaxLength="8" TextChanged="Camera_TextChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Elevation (deg)" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                        <TextBox x:Name="ElevationBox" MaxLength="8" TextChanged="Camera_TextChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Field of view" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                        <TextBox x:Name="FieldOfViewBox" MaxLength="8" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Frame fill" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=FillSlider, StringFormat={}{0:F0}%}" />
                    <Slider x:Name="FillSlider" Grid.ColumnSpan="2" Minimum="50" Maximum="95" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,22,0,0" />
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Light intensity" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=LightSlider, StringFormat={}{0:F2}x}" />
                    <Slider x:Name="LightSlider" Grid.ColumnSpan="2" Minimum="0.25" Maximum="2" SmallChange="0.05" Margin="0,22,0,0" />
                </Grid>
                <CheckBox x:Name="FactionColoursCheckBox" Content="Faction colours" Foreground="#D8D4C1" Margin="0,18,0,8" />
                <Grid IsEnabled="{Binding IsChecked, ElementName=FactionColoursCheckBox}">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Primary" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                        <DockPanel>
                            <Button x:Name="PrimarySwatch" DockPanel.Dock="Right" Width="36" Margin="8,0,0,0" Padding="0" Tag="Primary" ToolTip="Choose primary colour" Click="ColourPicker_Click" />
                            <TextBox x:Name="PrimaryHexBox" MaxLength="7" FontFamily="Consolas" CharacterCasing="Upper" TextChanged="Colour_TextChanged" />
                        </DockPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Secondary" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                        <DockPanel>
                            <Button x:Name="SecondarySwatch" DockPanel.Dock="Right" Width="36" Margin="8,0,0,0" Padding="0" Tag="Secondary" ToolTip="Choose secondary colour" Click="ColourPicker_Click" />
                            <TextBox x:Name="SecondaryHexBox" MaxLength="7" FontFamily="Consolas" CharacterCasing="Upper" TextChanged="Colour_TextChanged" />
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <ProgressBar x:Name="BatchProgressBar" Height="6" Minimum="0" Maximum="1" Foreground="{StaticResource AccentBrush}" />
            <TextBlock x:Name="ProgressText" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" />
            <TextBlock x:Name="CurrentMeshText" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" MaxHeight="60" />
        </StackPanel>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button x:Name="OpenOutputButton" HorizontalAlignment="Left" ToolTip="Open output folder" Click="OpenOutput_Click" IsEnabled="False">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" />
            </Button>
            <Button x:Name="RunButton" Grid.Column="1" MinWidth="132" Click="StartBatch_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Start batch" />
                </StackPanel>
            </Button>
            <Button x:Name="CancelButton" Grid.Column="2" Width="94" Margin="8,0,0,0" Content="Close" Click="Cancel_Click" />
        </Grid>
    </Grid>
</Window>
