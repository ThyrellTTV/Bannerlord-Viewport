<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>LOTRAOM_Viewport</RootNamespace>
    <AssemblyName>Bannerlord Viewport</AssemblyName>
    <Product>Bannerlord Viewport</Product>
    <Version>0.1.0-beta.2</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Description>A desktop viewer and editing toolkit for Bannerlord TPAC assets, troops, crafting pieces, renders, and source XML.</Description>
    <RepositoryUrl>https://github.com/ThyrellTTV/Bannerlord-Viewport</RepositoryUrl>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <PackageReference Include="HelixToolkit.Wpf.SharpDX" Version="3.1.2" />
    <PackageReference Include="AssimpNet" Version="5.0.0-beta1" />
    <Compile Remove="third_party\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <Compile Include="third_party\TpacTool\Export\*.cs" />
    <None Remove="third_party\**\*.cs" />
    <ProjectReference Include="third_party\TpacTool\TpacTool.Lib\TpacTool.Lib.csproj" />
    <None Include="third_party\TpacTool\LICENSE" Link="Licenses\TpacTool.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="third_party\TAOM\LICENSE" Link="Licenses\TAOM.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="third_party\AssimpNet\LICENSE.txt" Link="Licenses\AssimpNet.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="third_party\HelixToolkit\LICENSE" Link="Licenses\HelixToolkit.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="third_party\SharpDX\LICENSE" Link="Licenses\SharpDX.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="third_party\lz4net\LICENSE" Link="Licenses\lz4net.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="README.md" CopyToPublishDirectory="PreserveNewest" />
    <None Update="RELEASE_NOTES.md" CopyToPublishDirectory="PreserveNewest" />
    <None Update="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
