<Window x:Class="LOTRAOM_Viewport.AssetExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export FBX and Textures" Width="500" Height="620" MinWidth="440" MinHeight="480"
        Background="#0C1016" Foreground="#ECE8D8" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A281A" />
            <Setter Property="BorderBrush" Value="#4A4324" />
            <Setter Property="Foreground" Value="#F3EFD9" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="FBX / TEXTURES" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="14" Margin="0,0,0,14" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SettingsPanel" Margin="0,0,12,0">
                <TextBlock Text="Output folder" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderBox" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <Button Grid.Column="1" Width="36" Margin="8,0,0,0" Padding="0" ToolTip="Choose output folder" Click="Browse_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" />
                    </Button>
                </Grid>
                <TextBlock Text="Output name" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4" />
                <TextBox x:Name="NameBox" MaxLength="100" />
                <CheckBox x:Name="FbxCheck" Content="FBX mesh" Foreground="#D8D4C1" Margin="0,16,0,0" />
                <CheckBox x:Name="TexturesCheck" Content="Referenced textures" Foreground="#D8D4C1" Margin="0,10,0,0" />
                <TextBlock Text="Texture format" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4" />
                <ComboBox x:Name="FormatCombo" IsEditable="False">
                    <ComboBoxItem Content="PNG" /><ComboBoxItem Content="DDS (original compression and mipmaps)" /><ComboBoxItem Content="PNG and DDS" />
                </ComboBox>
                <TextBlock Text="Detail level" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4" />
                <ComboBox x:Name="LodCombo" IsEditable="False">
                    <ComboBoxItem Content="Highest detail" /><ComboBoxItem Content="All available LODs" />
                </ComboBox>
                <StackPanel x:Name="PosePanel" Margin="0,12,0,0">
                    <TextBlock Text="Pose" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                    <ComboBox x:Name="PoseCombo" IsEditable="False">
                        <ComboBoxItem Content="Bind pose" /><ComboBoxItem Content="Current pose (static)" />
                    </ComboBox>
                </StackPanel>
                <CheckBox x:Name="SkeletonCheck" Content="Include human skeleton and weights" Foreground="#D8D4C1" Margin="0,10,0,8" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <ProgressBar x:Name="ProgressBar" Height="6" IsIndeterminate="False" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" MaxHeight="68" />
        </StackPanel>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button x:Name="OpenButton" Width="36" Padding="0" ToolTip="Open output folder" Click="Open_Click" IsEnabled="False">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" />
            </Button>
            <Button x:Name="CancelButton" Grid.Column="2" Content="Close" MinWidth="80" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button x:Name="ExportButton" Grid.Column="3" MinWidth="100" Click="Export_Click">
                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock Text="Export" /></StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
