<Window x:Class="LOTRAOM_Viewport.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Bannerlord Viewport"
        MinHeight="720"
        MinWidth="1180"
        Height="820"
        Width="1440"
        Background="#0C1016"
        Foreground="#ECE8D8"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#171811" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#31301F" />
        <SolidColorBrush x:Key="AccentBrush" Color="#BD9C2A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8F8B78" />

        <Style x:Key="InspectorSectionStyle" TargetType="Expander">
            <Setter Property="Foreground" Value="#ECE8D8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          HorizontalContentAlignment="Stretch" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderBorder" Background="Transparent" BorderBrush="#23303B"
                                                BorderThickness="0,0,0,1" Padding="14,0" Height="42">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
                                                <ContentPresenter VerticalAlignment="Center" />
                                                <TextBlock x:Name="Chevron" Grid.Column="1" FontFamily="Segoe MDL2 Assets" Text="&#xE76C;"
                                                           FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="#182129" /></Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="SectionContent" Padding="14,10,14,14" Visibility="Collapsed">
                                <ContentPresenter ContentSource="Content" />
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="SectionContent" Property="Visibility" Value="Visible" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InspectorPreviewStyle" TargetType="Expander" BasedOn="{StaticResource InspectorSectionStyle}">
            <Setter Property="Margin" Value="-14,8,-14,4" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A281A" />
            <Setter Property="BorderBrush" Value="#4A4324" />
            <Setter Property="Foreground" Value="#F3EFD9" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#101419" />
            <Setter Property="BorderBrush" Value="#343A40" />
            <Setter Property="Foreground" Value="#D8D4C1" />
            <Setter Property="Padding" Value="8,6" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#101419" />
            <Setter Property="BorderBrush" Value="#343A40" />
            <Setter Property="Foreground" Value="#D8D4C1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="IsEditable" Value="True" />
            <Setter Property="IsTextSearchEnabled" Value="True" />
            <Setter Property="StaysOpenOnEdit" Value="True" />
            <Setter Property="MaxDropDownHeight" Value="260" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="30" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="PART_EditableTextBox"
                                             Grid.Column="0"
                                             Margin="0"
                                             Padding="{TemplateBinding Padding}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{TemplateBinding Foreground}"
                                             CaretBrush="{StaticResource AccentBrush}"
                                             VerticalContentAlignment="Center"
                                             Focusable="True" />

                                    <ContentPresenter x:Name="ContentSite"
                                                      Grid.Column="0"
                                                      Margin="{TemplateBinding Padding}"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      IsHitTestVisible="False"
                                                      VerticalAlignment="Center"
                                                      Visibility="Collapsed" />

                                    <ToggleButton x:Name="DropDownToggle"
                                                  Grid.Column="1"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <Path Fill="#AFA890"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M 0 0 L 4 4 L 8 0 Z" />
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#101419"
                                        BorderBrush="#343A40"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                    <ScrollViewer Padding="0"
                                                  CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#4B4324" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEditable" Value="False">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#101419" />
            <Setter Property="Foreground" Value="#D8D4C1" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#1B232B"
                                BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#242617" />
                                <Setter Property="Foreground" Value="#F3EFD9" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2C2917" />
                                <Setter Property="Foreground" Value="#F3EFD9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TreeView">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#EEEAD8" />
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Foreground" Value="#EEEAD8" />
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#9D9988" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Root"
                                Background="#14150E"
                                BorderBrush="#2B2A1B"
                                BorderThickness="1,1,1,1"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter x:Name="ContentSite"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                                <Border x:Name="AccentLine"
                                        Height="2"
                                        VerticalAlignment="Bottom"
                                        Background="Transparent"
                                        Margin="0,0,0,-9" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#202113" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#4B4324" />
                                <Setter TargetName="AccentLine" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="#F3EFD9" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1B1C12" />
                                <Setter Property="Foreground" Value="#E5DEC6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#EEEAD8" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="BANNERLORD ASSET VIEWER"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="11"
                               FontWeight="Bold" />
                    <TextBlock Text="BANNERLORD VIEWPORT"
                               Margin="0,8,0,18"
                               FontSize="23"
                               FontWeight="Bold"
                               FontStretch="Condensed" />
                </StackPanel>

                <TabControl x:Name="WorkspaceTabs"
                            Grid.Row="1"
                            Margin="0,0,0,14"
                            SelectionChanged="WorkspaceTabs_SelectionChanged">
                    <TabItem Header="Assets">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="AssetPathBox"
                                         Grid.Column="0"
                                         IsReadOnly="True"
                                         Text="Select Bannerlord AssetPackages folder..." />
                                <Button Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Click="ChooseAssetPackagesFolder_Click"
                                        Content="Browse" />
                                <TextBlock x:Name="ScanSummaryText"
                                           Grid.Row="1"
                                           Grid.ColumnSpan="2"
                                           Margin="0,8,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           Text="No packages loaded." />
                                <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Button x:Name="BatchRenderButton"
                                        Click="BatchRender_Click" ToolTip="Batch render parsed meshes">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE722;" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Batch Render" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Click="BatchTurntableExport_Click" ToolTip="Batch export turntables of parsed meshes" Padding="5,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7AD;" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Batch Turntables" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                </Grid>
                            </Grid>

                            <Border Grid.Row="1"
                                    BorderBrush="#292817"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <Grid Margin="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBox x:Name="AssetSearchBox"
                                             Margin="0,0,0,8"
                                             TextChanged="AssetSearchBox_TextChanged"
                                             Text="" />

                                    <TreeView x:Name="AssetTree"
                                              Grid.Row="1"
                                              SelectedItemChanged="AssetTree_SelectedItemChanged">
                                        <TreeView.ItemTemplate>
                                            <HierarchicalDataTemplate ItemsSource="{Binding Assets}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Badge}"
                                                               Margin="8,0,0,0"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               FontSize="11" />
                                                </StackPanel>
                                                <HierarchicalDataTemplate.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,3">
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Status}"
                                                                       Foreground="{StaticResource MutedBrush}"
                                                                       FontSize="11" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </HierarchicalDataTemplate.ItemTemplate>
                                            </HierarchicalDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Troops">
                        <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,12,0">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TroopXmlPathBox"
                                             IsReadOnly="True"
                                             Text="Select troop XML or folder..." />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Margin="8,0,0,0" Width="34" Padding="0"
                                                Click="ChooseTroopXml_Click" ToolTip="Open troop XML">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="14" />
                                        </Button>
                                        <Button Margin="6,0,0,0" Width="34" Padding="0"
                                                Click="ChooseTroopFolder_Click" ToolTip="Open troop folder">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="TroopSummaryText"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Text="No troop XML loaded." />

                                <Border Margin="0,10,0,14"
                                        Height="178"
                                        BorderBrush="#292817"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <Grid Margin="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBox x:Name="TroopSearchBox" Margin="0,0,0,8"
                                                 ToolTip="Search troops by name or ID"
                                                 TextChanged="TroopSearchBox_TextChanged" />
                                    <ListBox x:Name="TroopList" Grid.Row="1"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             SelectionChanged="TroopList_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,3">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                                                    <TextBlock Text="{Binding Id}"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Id}"
                                                               FontSize="11" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    </Grid>
                                </Border>

                                <TextBlock Text="CUSTOM LOADOUT"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="11"
                                           FontWeight="Bold" />

                                <Grid Margin="0,8,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Helmet" Foreground="{StaticResource MutedBrush}" Margin="0,6" />
                                    <ComboBox x:Name="HelmetCombo" Grid.Column="1" Margin="0,2" DisplayMemberPath="DisplayName" />
                                    <TextBlock Grid.Row="1" Text="Cape" Foreground="{StaticResource MutedBrush}" Margin="0,6" />
                                    <ComboBox x:Name="CapeCombo" Grid.Row="1" Grid.Column="1" Margin="0,2" DisplayMemberPath="DisplayName" />
                                    <TextBlock Grid.Row="2" Text="Body" Foreground="{StaticResource MutedBrush}" Margin="0,6" />
                                    <ComboBox x:Name="BodyCombo" Grid.Row="2" Grid.Column="1" Margin="0,2" DisplayMemberPath="DisplayName" />
                                    <TextBlock Grid.Row="3" Text="Arm" Foreground="{StaticResource MutedBrush}" Margin="0,6" />
                                    <ComboBox x:Name="ArmCombo" Grid.Row="3" Grid.Column="1" Margin="0,2" DisplayMemberPath="DisplayName" />
                                    <TextBlock Grid.Row="4" Text="Leg" Foreground="{StaticResource MutedBrush}" Margin="0,6" />
                                    <ComboBox x:Name="LegCombo" Grid.Row="4" Grid.Column="1" Margin="0,2" DisplayMemberPath="DisplayName" />
                                    <TextBlock Grid.Row="5" Text="Item0" Foreground="{StaticResource MutedBrush}" Margin="0,6" />
                                    <ComboBox x:Name="Item0Combo" Grid.Row="5" Grid.Column="1" Margin="0,2" DisplayMemberPath="DisplayName" />
                                    <TextBlock Grid.Row="6" Text="Item1" Foreground="{StaticResource MutedBrush}" Margin="0,6" />
                                    <ComboBox x:Name="Item1Combo" Grid.Row="6" Grid.Column="1" Margin="0,2" DisplayMemberPath="DisplayName" />
                                </Grid>

                                <Grid Margin="0,8,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Item0" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedBrush}" />
                                    <ComboBox x:Name="Item0StateCombo" Grid.Column="1" SelectedIndex="0" SelectionChanged="EquipmentState_SelectionChanged">
                                        <ComboBoxItem Content="Held" /><ComboBoxItem Content="Sheathed" />
                                    </ComboBox>
                                    <TextBlock Grid.Column="2" Text="Item1" VerticalAlignment="Center" Margin="12,0,8,0" Foreground="{StaticResource MutedBrush}" />
                                    <ComboBox x:Name="Item1StateCombo" Grid.Column="3" SelectedIndex="0" SelectionChanged="EquipmentState_SelectionChanged">
                                        <ComboBoxItem Content="Held" /><ComboBoxItem Content="Sheathed" />
                                    </ComboBox>
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Button Click="ApplyCustomLoadout_Click" Content="Apply" />
                                    <Button Margin="8,0,0,0" Click="ClearCustomLoadout_Click" Content="Clear" />
                                </StackPanel>
                                <StackPanel x:Name="TroopPosePanel" Margin="0,18,0,0">
                                    <StackPanel.Resources>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="Chrome" Property="Background" Value="#38331D" />
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.4" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </StackPanel.Resources>
                                <TextBlock Text="POSE" Margin="0,0,0,8"
                                           Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="PoseAnimationCombo" DisplayMemberPath="DisplayName"
                                              IsTextSearchEnabled="False" VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              SelectionChanged="PoseAnimationCombo_SelectionChanged">
                                        <ComboBox.ItemsPanel>
                                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                                        </ComboBox.ItemsPanel>
                                    </ComboBox>
                                    <Button Grid.Column="1" Margin="8,0,0,0" Width="34" Height="34" Padding="0"
                                            ToolTip="Load Native animation assets" Click="ChoosePoseAnimations_Click">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="14" />
                                    </Button>
                                </Grid>
                                <Grid Margin="0,10,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Frame" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox x:Name="PoseFrameBox" Grid.Column="1" Margin="8,0,0,0" Width="64" Height="30"
                                             Padding="6,4" FontFamily="Consolas" Text="0" IsEnabled="False"
                                             GotKeyboardFocus="PoseFrameBox_GotKeyboardFocus"
                                             LostFocus="PoseFrameBox_LostFocus" KeyDown="PoseFrameBox_KeyDown" />
                                    <TextBlock x:Name="PoseFrameRangeText" Grid.Column="2" Margin="8,0,0,0" Text="/ 0"
                                               VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                </Grid>
                                <Slider x:Name="PoseFrameSlider" Minimum="0" Maximum="0" Value="0" Height="24"
                                        TickFrequency="1" IsSnapToTickEnabled="True" IsEnabled="False"
                                        SmallChange="1" LargeChange="10" ValueChanged="PoseFrameSlider_ValueChanged"
                                        ToolTip="Animation frame" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="88" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="PosePlayButton" Width="34" Height="34" Padding="0" IsEnabled="False"
                                            ToolTip="Play animation" Click="PosePlay_Click">
                                        <TextBlock x:Name="PosePlayIcon" FontFamily="Segoe MDL2 Assets" Text="&#xE768;" FontSize="14" />
                                    </Button>
                                    <Button x:Name="PoseResetButton" Grid.Column="1" Width="34" Height="34" Margin="6,0,0,0" Padding="0"
                                            IsEnabled="False" ToolTip="Reset to bind pose" Click="PoseReset_Click">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE777;" FontSize="14" />
                                    </Button>
                                    <CheckBox x:Name="PoseLoopCheckBox" Grid.Column="2" Margin="12,0,8,0" VerticalAlignment="Center"
                                              Content="Loop" IsChecked="True" Foreground="#D8D4C1" />
                                    <ComboBox x:Name="PoseSpeedCombo" Grid.Column="3" IsEditable="False" SelectedIndex="2"
                                              ToolTip="Playback speed" Padding="6,6">
                                        <ComboBoxItem Content="0.25x" Tag="0.25" />
                                        <ComboBoxItem Content="0.5x" Tag="0.5" />
                                        <ComboBoxItem Content="1x" Tag="1" />
                                        <ComboBoxItem Content="2x" Tag="2" />
                                    </ComboBox>
                                </Grid>
                                <TextBlock x:Name="PoseStatusText" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}"
                                           FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem x:Name="CraftingTab" Header="Crafting">
                        <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,12,0">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="CraftingPiecesPathBox"
                                             IsReadOnly="True"
                                             Text="Select crafting_pieces.xml..." />
                                    <Button Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Click="ChooseCraftingPieces_Click"
                                            Content="Pieces" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="CraftingTemplatesPathBox"
                                             IsReadOnly="True"
                                             Text="Optional crafting_templates.xml/xslt..." />
                                    <Button Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Click="ChooseCraftingTemplates_Click"
                                            Content="Templates" />
                                </Grid>

                                <TextBlock x:Name="CraftingSummaryText"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           Text="No crafting pieces loaded." />

                                <TextBlock Text="WEAPON TEMPLATE"
                                           Margin="0,14,0,0"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="11"
                                           FontWeight="Bold" />
                                <ComboBox x:Name="CraftingTemplateCombo"
                                          Margin="0,8,0,12"
                                          IsEditable="False"
                                          SelectionChanged="CraftingTemplateCombo_SelectionChanged" />

                                <TextBlock Text="PIECES"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="11"
                                           FontWeight="Bold" />

                                <Grid Margin="0,8,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Blade" Foreground="{StaticResource MutedBrush}" Margin="0,6" />
                                    <ComboBox x:Name="CraftingBladeCombo"
                                              Grid.Column="1"
                                              Margin="0,2,0,8"
                                              DisplayMemberPath="Id"
                                              SelectionChanged="CraftingPieceCombo_SelectionChanged" />

                                    <TextBlock Grid.Row="1" Text="Guard" Foreground="{StaticResource MutedBrush}" Margin="0,6" />
                                    <ComboBox x:Name="CraftingGuardCombo"
                                              Grid.Row="1"
                                              Grid.Column="1"
                                              Margin="0,2,0,8"
                                              DisplayMemberPath="Id"
                                              SelectionChanged="CraftingPieceCombo_SelectionChanged" />

                                    <TextBlock Grid.Row="2" Text="Handle" Foreground="{StaticResource MutedBrush}" Margin="0,6" />
                                    <ComboBox x:Name="CraftingHandleCombo"
                                              Grid.Row="2"
                                              Grid.Column="1"
                                              Margin="0,2,0,8"
                                              DisplayMemberPath="Id"
                                              SelectionChanged="CraftingPieceCombo_SelectionChanged" />

                                    <TextBlock Grid.Row="3" Text="Pommel" Foreground="{StaticResource MutedBrush}" Margin="0,6" />
                                    <ComboBox x:Name="CraftingPommelCombo"
                                              Grid.Row="3"
                                              Grid.Column="1"
                                              Margin="0,2"
                                              DisplayMemberPath="Id"
                                              SelectionChanged="CraftingPieceCombo_SelectionChanged" />
                                </Grid>

                                <TextBlock x:Name="CraftingWeaponLengthText"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           Text="Weapon length: -" />

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Click="ApplyCraftingWeapon_Click" Content="Apply" />
                                    <Button Margin="8,0,0,0" Click="ClearCraftingWeapon_Click" Content="Clear" />
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

                <Border Grid.Row="2"
                        Margin="0,14,0,0"
                        BorderBrush="#292817"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Packages" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="PackageCountText"
                                   Grid.Column="1"
                                   FontWeight="Bold"
                                   Text="0" />
                        <TextBlock Grid.Row="1" Text="Mesh candidates" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="MeshCountText"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                   FontWeight="Bold"
                                   Text="0" />
                        <TextBlock Grid.Row="2" Text="Extractor" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="ExtractorStatusText"
                                   Grid.Row="2"
                                   Grid.Column="1"
                                   FontWeight="Bold"
                                   Text="not loaded" />
                        <CheckBox x:Name="SaveSettingsCheckBox"
                                  Grid.Row="3"
                                  Grid.ColumnSpan="2"
                                  Margin="0,10,0,0"
                                  Checked="SaveSettingsCheckBox_Changed"
                                  Unchecked="SaveSettingsCheckBox_Changed"
                                  Content="Save settings"
                                  Foreground="#D8D4C1" />
                        <TextBlock x:Name="SettingsStatusText"
                                   Grid.Row="4"
                                   Grid.ColumnSpan="2"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   Text="Settings are not saved." />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="#0D1219">
            <hx:Viewport3DX x:Name="ModelViewport"
                        ClipToBounds="True"
                        BackgroundColor="#0D1219"
                        ShowViewCube="False"
                        ShowCoordinateSystem="False"
                        UseDefaultGestures="False"
                        IsRotationEnabled="False"
                        IsPanEnabled="False"
                        IsZoomEnabled="False"
                        EnableSwapChainRendering="False"
                        FXAALevel="High"
                        MouseDown="ModelViewport_MouseDown"
                        MouseMove="ModelViewport_MouseMove"
                        MouseUp="ModelViewport_MouseUp"
                        MouseWheel="ModelViewport_MouseWheel">
                <hx:Viewport3DX.Camera>
                    <hx:PerspectiveCamera x:Name="ViewportCamera"
                                       FieldOfView="45"
                                       Position="4,3,6"
                                       LookDirection="-4,-3,-6"
                                       UpDirection="0,1,0" />
                </hx:Viewport3DX.Camera>
            </hx:Viewport3DX>

            <Grid VerticalAlignment="Stretch" Margin="24,24,24,78">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
            <Border HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="0,0,16,0"
                    MaxWidth="620"
                    Background="#BB0B1016"
                    BorderBrush="#23303B"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="14,12">
                <StackPanel>
                    <TextBlock x:Name="SelectedAssetTitle"
                               Text="No mesh selected"
                               TextWrapping="Wrap"
                               FontSize="18"
                               FontWeight="Bold" />
                    <TextBlock x:Name="SelectedAssetSubtitle"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Foreground="#A9B0B8"
                               Text="Choose an AssetPackages folder to begin.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Grid x:Name="InspectorHost" Grid.Column="1" HorizontalAlignment="Right">
            <Border x:Name="ViewportInspector" VerticalAlignment="Top" MaxHeight="{Binding ActualHeight, ElementName=InspectorHost}"
                    Background="#F20B1016" BorderBrush="#23303B" BorderThickness="1" CornerRadius="4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="380" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=InspectorCollapseToggle}" Value="True"><Setter Property="Width" Value="40" /></DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Visibility, ElementName=CraftingEditorPanel}" Value="Collapsed" />
                                    <Condition Binding="{Binding Visibility, ElementName=ItemPositionEditorPanel}" Value="Collapsed" />
                                    <Condition Binding="{Binding Visibility, ElementName=TableauColourPanel}" Value="Collapsed" />
                                    <Condition Binding="{Binding Visibility, ElementName=TroopXmlExportPanel}" Value="Collapsed" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                    <Grid Height="40">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="INSPECTOR" Margin="14,0,0,0" VerticalAlignment="Center"
                                   FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}">
                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=InspectorCollapseToggle}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <ToggleButton x:Name="InspectorCollapseToggle" Grid.Column="1" Width="28" Height="28" Margin="5,0"
                                      IsChecked="False" Cursor="Hand" Foreground="#ECE8D8">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="ToolTip" Value="Hide inspector" />
                                    <Setter Property="Template"><Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="ToggleBorder" Background="Transparent" CornerRadius="3">
                                                <TextBlock x:Name="ToggleGlyph" FontFamily="Segoe MDL2 Assets" Text="&#xE70E;" FontSize="13"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleBorder" Property="Background" Value="#23303B" /></Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ToggleBorder" Property="Background" Value="#23303B" /></Trigger>
                                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="ToggleGlyph" Property="Text" Value="&#xE713;" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value></Setter>
                                    <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="ToolTip" Value="Show inspector" /></Trigger></Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </Grid>
                    <ScrollViewer x:Name="InspectorSectionsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=InspectorCollapseToggle}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers></Style></ScrollViewer.Style>
            <StackPanel>
            <Border x:Name="CraftingEditorPanel" Visibility="Collapsed">
                <Expander x:Name="CraftingInspectorSection" Header="Offset editor" Style="{StaticResource InspectorSectionStyle}" Expanded="InspectorSection_Expanded">
                    <StackPanel>
                        <TextBlock x:Name="CraftingActivePieceText"
                                   Text="Select a piece to edit."
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Step"
                                   Margin="0,10,0,4"
                                   Foreground="{StaticResource MutedBrush}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="0.1" Foreground="#F3EFD9" Tag="0.1" GroupName="CraftingStep" Margin="0,0,12,0" Checked="CraftingStepRadio_Checked" />
                            <RadioButton Content="0.5" Foreground="#F3EFD9" Tag="0.5" GroupName="CraftingStep" Margin="0,0,12,0" Checked="CraftingStepRadio_Checked" />
                            <RadioButton Content="1" Foreground="#F3EFD9" Tag="1" GroupName="CraftingStep" Margin="0,0,12,0" IsChecked="True" Checked="CraftingStepRadio_Checked" />
                            <RadioButton Content="5" Foreground="#F3EFD9" Tag="5" GroupName="CraftingStep" Checked="CraftingStepRadio_Checked" />
                        </StackPanel>

                        <TextBlock Text="piece_offset" Margin="0,10,0,4" Foreground="{StaticResource MutedBrush}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CraftingPieceOffsetBox" LostFocus="CraftingOffsetBox_LostFocus" KeyDown="CraftingOffsetBox_KeyDown" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Content="-" Tag="piece_offset,-1" Click="CraftingOffsetStep_Click" />
                            <Button Grid.Column="2" Margin="6,0,0,0" Content="+" Tag="piece_offset,1" Click="CraftingOffsetStep_Click" />
                        </Grid>

                        <TextBlock Text="previous_piece_offset" Margin="0,10,0,4" Foreground="{StaticResource MutedBrush}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CraftingPreviousOffsetBox" LostFocus="CraftingOffsetBox_LostFocus" KeyDown="CraftingOffsetBox_KeyDown" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Content="-" Tag="previous_piece_offset,-1" Click="CraftingOffsetStep_Click" />
                            <Button Grid.Column="2" Margin="6,0,0,0" Content="+" Tag="previous_piece_offset,1" Click="CraftingOffsetStep_Click" />
                        </Grid>

                        <TextBlock Text="next_piece_offset" Margin="0,10,0,4" Foreground="{StaticResource MutedBrush}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CraftingNextOffsetBox" LostFocus="CraftingOffsetBox_LostFocus" KeyDown="CraftingOffsetBox_KeyDown" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Content="-" Tag="next_piece_offset,-1" Click="CraftingOffsetStep_Click" />
                            <Button Grid.Column="2" Margin="6,0,0,0" Content="+" Tag="next_piece_offset,1" Click="CraftingOffsetStep_Click" />
                        </Grid>

                        <TextBlock Text="scale_factor (%)" Margin="0,10,0,4" Foreground="{StaticResource MutedBrush}" />
                        <TextBox x:Name="CraftingScaleBox" LostFocus="CraftingOffsetBox_LostFocus" KeyDown="CraftingOffsetBox_KeyDown" />

                        <Expander x:Name="CraftingXmlPreview" Header="XML preview" Style="{StaticResource InspectorPreviewStyle}">
                        <TextBox x:Name="CraftingXmlOutputBox"
                                 Height="130"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" />
                        </Expander>
                        <Button Margin="0,8,0,0"
                                Click="CopyCraftingBuildData_Click"
                                Content="Copy XML" />
                        <Button Margin="0,8,0,0"
                                Click="SaveCraftingSourceXml_Click" ToolTip="Save crafting edits to their source XML, with backups"
                                Content="Save XML" />
                        <Button Margin="0,8,0,0"
                                Click="ExportCraftingOffsets_Click"
                                Content="Export tuned offsets (JSON)" />
                    </StackPanel>
                </Expander>
            </Border>

            <Border x:Name="ItemPositionEditorPanel" Visibility="Collapsed">
                <Expander x:Name="ItemPositionInspectorSection" Header="Equipment position" Style="{StaticResource InspectorSectionStyle}" Expanded="InspectorSection_Expanded">
                    <StackPanel>
                        <ComboBox x:Name="ItemPositionItemCombo" IsEditable="False" SelectionChanged="ItemPositionSelection_Changed">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox x:Name="ItemPositionModeCombo" Margin="0,8,0,0" IsEditable="False" SelectedIndex="0" SelectionChanged="ItemPositionSelection_Changed">
                            <ComboBoxItem Content="Held" /><ComboBoxItem Content="Holstered / carried" />
                        </ComboBox>
                        <Grid x:Name="ItemPositionAttachmentSteps" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Position step (cm)" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                                <ComboBox x:Name="ItemPositionStepCombo" IsEditable="False" SelectedIndex="2"><ComboBoxItem Content="0.1" /><ComboBoxItem Content="0.5" /><ComboBoxItem Content="1" /><ComboBoxItem Content="5" /></ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Rotation step (degrees)" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                                <ComboBox x:Name="ItemRotationStepCombo" IsEditable="False" SelectedIndex="1"><ComboBoxItem Content="1" /><ComboBoxItem Content="5" /><ComboBoxItem Content="15" /></ComboBox>
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="ItemPositionFields">
                            <TextBlock Text="Position / shift (cm)" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,3" />
                            <StackPanel x:Name="ItemPositionTranslationRows" />
                            <TextBlock x:Name="ItemPositionRotationLabel" Text="Rotation (degrees)" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,3" />
                            <StackPanel x:Name="ItemPositionRotationRows" />
                        </StackPanel>
                        <Expander x:Name="TroopCraftingOffsetsPanel" Header="Crafting piece offsets" Style="{StaticResource InspectorPreviewStyle}"
                                  IsExpanded="True" Visibility="Collapsed">
                            <StackPanel x:Name="TroopCraftingOffsetFields">
                                <ComboBox x:Name="TroopCraftingPieceCombo" IsEditable="False" SelectionChanged="TroopCraftingPiece_Changed">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="100" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Offset step (cm)" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                    <ComboBox x:Name="TroopCraftingStepCombo" Grid.Column="1" IsEditable="False" SelectedIndex="2">
                                        <ComboBoxItem Content="0.1" /><ComboBoxItem Content="0.5" /><ComboBoxItem Content="1" /><ComboBoxItem Content="5" />
                                    </ComboBox>
                                    <Button Grid.Column="2" Width="34" Height="30" Padding="0" HorizontalAlignment="Right" ToolTip="Reset selected piece offsets" Click="TroopCraftingReset_Click">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" />
                                    </Button>
                                </Grid>
                                <TextBlock Text="piece_offset (cm)" Margin="0,10,0,4" Foreground="{StaticResource MutedBrush}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="34" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="TroopCraftingOffsetBox" LostFocus="TroopCraftingOffset_LostFocus" KeyDown="TroopCraftingOffset_KeyDown" />
                                    <Button Grid.Column="1" Margin="6,0,0,0" Padding="0" Content="-" Tag="0,-1" ToolTip="Decrease piece offset" Click="TroopCraftingOffsetStep_Click" />
                                    <Button Grid.Column="2" Margin="6,0,0,0" Padding="0" Content="+" Tag="0,1" ToolTip="Increase piece offset" Click="TroopCraftingOffsetStep_Click" />
                                </Grid>
                                <TextBlock Text="previous_piece_offset (cm)" Margin="0,10,0,4" Foreground="{StaticResource MutedBrush}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="34" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="TroopCraftingPreviousBox" LostFocus="TroopCraftingOffset_LostFocus" KeyDown="TroopCraftingOffset_KeyDown" />
                                    <Button Grid.Column="1" Margin="6,0,0,0" Padding="0" Content="-" Tag="1,-1" ToolTip="Decrease previous-piece offset" Click="TroopCraftingOffsetStep_Click" />
                                    <Button Grid.Column="2" Margin="6,0,0,0" Padding="0" Content="+" Tag="1,1" ToolTip="Increase previous-piece offset" Click="TroopCraftingOffsetStep_Click" />
                                </Grid>
                                <TextBlock Text="next_piece_offset (cm)" Margin="0,10,0,4" Foreground="{StaticResource MutedBrush}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="34" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="TroopCraftingNextBox" LostFocus="TroopCraftingOffset_LostFocus" KeyDown="TroopCraftingOffset_KeyDown" />
                                    <Button Grid.Column="1" Margin="6,0,0,0" Padding="0" Content="-" Tag="2,-1" ToolTip="Decrease next-piece offset" Click="TroopCraftingOffsetStep_Click" />
                                    <Button Grid.Column="2" Margin="6,0,0,0" Padding="0" Content="+" Tag="2,1" ToolTip="Increase next-piece offset" Click="TroopCraftingOffsetStep_Click" />
                                </Grid>
                            </StackPanel>
                        </Expander>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="ItemPositionUndoButton" Width="36" Padding="0" Height="30" ToolTip="Undo item adjustment" Click="ItemPositionHistory_Click"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7A7;" /></Button>
                            <Button x:Name="ItemPositionRedoButton" Width="36" Padding="0" Height="30" Margin="6,0,0,0" ToolTip="Redo item adjustment" Click="ItemPositionHistory_Click"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7A6;" /></Button>
                            <Button x:Name="ItemPositionResetButton" Width="36" Padding="0" Height="30" Margin="6,0,0,0" ToolTip="Reset this attachment mode" Click="ItemPositionHistory_Click"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" /></Button>
                            <Button x:Name="ItemPositionCraftingButton" Content="Open in crafting" Margin="10,0,0,0" Padding="8,4" Visibility="Collapsed" Click="ItemPositionCrafting_Click" />
                        </StackPanel>
                        <Expander x:Name="ItemPositionXmlPreview" Header="XML preview" Style="{StaticResource InspectorPreviewStyle}">
                        <TextBox x:Name="ItemPositionXmlBox" Height="115" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                        </Expander>
                        <ComboBox x:Name="ItemPositionExportModeCombo" IsEditable="False" SelectedIndex="0" Margin="0,8,0,0" ToolTip="XML preview and clipboard format" SelectionChanged="ItemPositionSelection_Changed">
                            <ComboBoxItem Content="Positioning only" /><ComboBoxItem Content="Full item definition" />
                        </ComboBox>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Button Click="CopyItemPositionXml_Click" ToolTip="Copy item positioning and any companion definitions">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C8;" Margin="0,0,8,0" /><TextBlock Text="Copy XML" /></StackPanel>
                            </Button>
                            <Button Grid.Column="2" Click="SaveItemPositionXml_Click" ToolTip="Save item edits directly to source XML, with backups">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" Margin="0,0,8,0" /><TextBlock Text="Save XML" /></StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="ItemPositionStatusText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Expander>
            </Border>
            <Border x:Name="TableauColourPanel" Visibility="Collapsed">
                <Expander x:Name="TableauInspectorSection" Header="Faction colours" Style="{StaticResource InspectorSectionStyle}" Expanded="InspectorSection_Expanded">
                <StackPanel>
                    <TextBlock Text="Primary" Margin="0,0,0,4" Foreground="{StaticResource MutedBrush}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TableauPrimaryHexBox" Text="#FFFFFF" FontFamily="Consolas"
                                 MaxLength="7" CharacterCasing="Upper" Height="34" VerticalContentAlignment="Center"
                                 Tag="Primary" TextChanged="TableauHex_TextChanged" LostFocus="TableauHex_LostFocus" />
                        <Button x:Name="TableauPrimarySwatch" Grid.Column="1" Margin="8,0,0,0"
                                Width="40" Height="34" Padding="0" Tag="Primary"
                                Background="White" ToolTip="Choose primary colour" Click="TableauColourPicker_Click" />
                    </Grid>
                    <TextBlock Text="Secondary" Margin="0,10,0,4" Foreground="{StaticResource MutedBrush}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TableauSecondaryHexBox" Text="#FFFFFF" FontFamily="Consolas"
                                 MaxLength="7" CharacterCasing="Upper" Height="34" VerticalContentAlignment="Center"
                                 Tag="Secondary" TextChanged="TableauHex_TextChanged" LostFocus="TableauHex_LostFocus" />
                        <Button x:Name="TableauSecondarySwatch" Grid.Column="1" Margin="8,0,0,0"
                                Width="40" Height="34" Padding="0" Tag="Secondary"
                                Background="White" ToolTip="Choose secondary colour" Click="TableauColourPicker_Click" />
                    </Grid>
                </StackPanel>
                </Expander>
            </Border>
            <Border x:Name="TroopXmlExportPanel" Visibility="Collapsed">
                <Expander x:Name="TroopXmlInspectorSection" Header="Equipment roster XML" Style="{StaticResource InspectorSectionStyle}" Expanded="InspectorSection_Expanded">
                <StackPanel>
                    <TextBlock x:Name="TroopXmlSourceText" Margin="0,0,0,8" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBox x:Name="TroopXmlOutputBox" Height="180"
                             IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CopyTroopXmlButton" Margin="0,0,4,0"
                                ToolTip="Copy equipment roster XML" Click="CopyTroopXml_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C8;" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Copy XML" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ExportTroopXmlButton" Grid.Column="1" Margin="4,0,0,0"
                                ToolTip="Save this troop's loadout and equipped item edits directly to source XML, with backups" Click="ExportTroopXml_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Save XML" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="TroopXmlStatusText" Margin="0,8,0,0"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                </Expander>
            </Border>
            </StackPanel>
            </ScrollViewer>
                </Grid>
            </Border>
            </Grid>
            </Grid>

            <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24,24,74,24"
                    Width="42" Height="38" Padding="0" ToolTip="Export FBX and textures" Click="AssetExport_Click">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" FontSize="18" />
            </Button>
            <ToggleButton x:Name="RenderExportToggle" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Margin="24" Width="42" Height="38" ToolTip="Export render"
                          Background="#2A281A" BorderBrush="#4A4324" Foreground="#F3EFD9" Cursor="Hand"
                          Checked="RenderExportToggle_Checked">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ExportIconBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ExportIconBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ExportIconBorder" Property="Background" Value="#38321B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE722;" FontSize="18" />
            </ToggleButton>
            <Popup x:Name="RenderExportPopup" PlacementTarget="{Binding ElementName=RenderExportToggle}" Closed="RenderExportPopup_Closed"
                   Placement="Top" StaysOpen="False" AllowsTransparency="True"
                   IsOpen="{Binding IsChecked, ElementName=RenderExportToggle, Mode=TwoWay}">
                <Border Width="300" Margin="0,0,0,8" Background="#F20B1016" BorderBrush="#23303B"
                        BorderThickness="1" CornerRadius="4" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="RENDER EXPORT" Foreground="{StaticResource AccentBrush}"
                                   FontSize="11" FontWeight="Bold" />
                        <ComboBox x:Name="RenderSizePreset" Margin="0,12,0,8" SelectedIndex="0" IsEditable="False"
                                  SelectionChanged="RenderSizePreset_SelectionChanged">
                            <ComboBoxItem Content="Current viewport" />
                            <ComboBoxItem Content="Square (2048 x 2048)" />
                            <ComboBoxItem Content="Portrait (2048 x 3072)" />
                            <ComboBoxItem Content="4K (3840 x 2160)" />
                            <ComboBoxItem Content="Custom" />
                        </ComboBox>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Width (px)" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                                <TextBox x:Name="RenderWidthBox" Text="2048" MaxLength="4" TextChanged="RenderDimension_TextChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Height (px)" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                                <TextBox x:Name="RenderHeightBox" Text="2048" MaxLength="4" TextChanged="RenderDimension_TextChanged" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Background" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,4" />
                        <ComboBox x:Name="RenderBackgroundCombo" SelectedIndex="0" IsEditable="False" SelectionChanged="RenderSetting_Changed">
                            <ComboBoxItem Content="Transparent" />
                            <ComboBoxItem Content="Studio" />
                        </ComboBox>
                        <CheckBox x:Name="RenderGridCheckBox" Content="Grid" Foreground="#F3EFD9" Margin="0,12,0,0"
                                  Checked="RenderSetting_Changed" Unchecked="RenderSetting_Changed" />
                        <Button x:Name="SaveRenderButton" Margin="0,12,0,0" ToolTip="Save render as PNG" Click="ExportRender_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Export PNG" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,8,0,0" ToolTip="Export a 360 degree turntable" Click="TurntableExport_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7F4;" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Turntable export" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="RenderExportStatusText" Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Grid>
</Window>
