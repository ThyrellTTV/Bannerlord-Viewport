<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>LOTRAOM_Viewport</RootNamespace>
    <AssemblyName>Bannerlord Viewport</AssemblyName>
    <Product>Bannerlord Viewport</Product>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <PackageReference Include="HelixToolkit.Wpf.SharpDX" Version="3.1.2" />
    <Compile Remove="third_party\**\*.cs" />
    <None Remove="third_party\**\*.cs" />
    <ProjectReference Include="third_party\TpacTool\TpacTool.Lib\TpacTool.Lib.csproj" />
  </ItemGroup>

</Project>
